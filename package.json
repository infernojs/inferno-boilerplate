{
  "name": "inferno-boilerplate",
  "version": "0.0.1",
  "description": "A basic boilerplate to get you started with Inferno + Inferno Router + JSX",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack-dev-server --config webpack.conf.js --host 0.0.0.0",
    "build": "webpack --mode=production --config webpack.conf.js",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trueadm/inferno-boilerplate.git"
  },
  "keywords": [
    "inferno",
    "boilerplate",
    "cerebral",
    "jsx"
  ],
  "author": "Dominic Gannaway",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trueadm/inferno-boilerplate/issues"
  },
  "homepage": "https://github.com/trueadm/inferno-boilerplate#readme",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.6",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-inferno": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-inferno": "^7.42.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "inferno-devtools": "^7",
    "url": "^0.11.4",
    "webpack": "5.111.1",
    "webpack-dev-server": "6.0.0"
  },
  "dependencies": {
    "history": "^5.3.0",
    "inferno": "^10.0.0",
    "inferno-create-element": "^10.0.0",
    "inferno-router": "^10.0.0",
    "webpack-cli": "^7.2.3"
  }
}
